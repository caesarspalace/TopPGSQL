<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane stylesheets="@estilos.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="speco.toppgsql.FXMLLockController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Árbol de Bloqueos (Lock Tree)" />
            <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS" spacing="10.0">
               <children>
                  <Button fx:id="btnRefrescar" mnemonicParsing="false" text="Refrescar" />
                  <Button fx:id="btnKillProcess" mnemonicParsing="false" styleClass="button-danger" text="Cancelar PID" />
               </children>
            </HBox>
         </children>
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
      </HBox>
   </top>
   <center>
      <TableView fx:id="tblLockTree" prefHeight="400.0" prefWidth="950.0" BorderPane.alignment="CENTER">
        <columns>
          <TableColumn fx:id="colVisualTree" prefWidth="120.0" text="Árbol Visual">
             <cellValueFactory>
                <PropertyValueFactory property="visual_tree" />
             </cellValueFactory>
          </TableColumn>
          <TableColumn fx:id="colBlockingPid" prefWidth="80.0" text="PID Blocker">
             <cellValueFactory>
                <PropertyValueFactory property="blocking_pid" />
             </cellValueFactory>
          </TableColumn>
          <TableColumn fx:id="colBlockedPid" prefWidth="80.0" text="PID Blocked">
             <cellValueFactory>
                <PropertyValueFactory property="blocked_pid" />
             </cellValueFactory>
          </TableColumn>
            <TableColumn fx:id="colUserBlocker" prefWidth="100.0" text="Usuario Blocker">
               <cellValueFactory>
                  <PropertyValueFactory property="usuario_bloqueador" />
               </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colUserBlocked" prefWidth="100.0" text="Usuario Blocked">
               <cellValueFactory>
                  <PropertyValueFactory property="usuario_bloqueado" />
               </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colWaitEventType" prefWidth="110.0" text="Tipo Espera">
               <cellValueFactory>
                  <PropertyValueFactory property="wait_event_type" />
               </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colWaitEvent" prefWidth="100.0" text="Evento Espera">
               <cellValueFactory>
                  <PropertyValueFactory property="wait_event" />
               </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colTiempoEspera" prefWidth="90.0" text="Tiempo (s)">
               <cellValueFactory>
                  <PropertyValueFactory property="tiempo_espera_seg" />
               </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colQueryBlocker" prefWidth="150.0" text="Consulta Bloqueadora">
               <cellValueFactory>
                  <PropertyValueFactory property="consulta_bloqueadora" />
               </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colQueryBlocked" prefWidth="150.0" text="Consulta Bloqueada">
               <cellValueFactory>
                  <PropertyValueFactory property="consulta_bloqueada" />
               </cellValueFactory>
            </TableColumn>
        </columns>
         <columnResizePolicy>
            <TableView fx:constant="UNCONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
      </TableView>
   </center>
</BorderPane>